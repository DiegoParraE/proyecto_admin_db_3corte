# Plantilla sin credenciales. Copiar a app/.env solo si se ejecuta
# la aplicacion fuera de Docker y completar con valores locales.
# No subir app/.env al repositorio.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=concesionario_db

AUTH_DB_USER=cambiar_usuario_auth
AUTH_DB_PASSWORD=cambiar_clave_auth

ADMIN_DB_USER=cambiar_usuario_admin
ADMIN_DB_PASSWORD=cambiar_clave_admin

VENDEDOR_DB_USER=cambiar_usuario_vendedor
VENDEDOR_DB_PASSWORD=cambiar_clave_vendedor

CONSULTA_DB_USER=cambiar_usuario_consulta
CONSULTA_DB_PASSWORD=cambiar_clave_consulta

SECRET_KEY=cambiar_por_una_cadena_larga_y_aleatoria
